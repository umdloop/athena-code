<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_mock_ros2_control" params="name">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="calculate_dynamics">true</param>
        <param name="custom_interface_with_following_offset"></param>
        <param name="disable_commands">false</param>
        <param name="mock_gpio_commands">false</param>
        <param name="mock_sensor_commands">true</param>
        <param name="position_state_following_offset">0.0</param>
      </hardware>

      <joint name="base_yaw">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <command_interface name="maintenance_request"/>
        <command_interface name="maintenance_frame_high"/>
        <command_interface name="maintenance_frame_low"/>
        <command_interface name="maintenance_data_count"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="motor_temperature"/>
        <state_interface name="torque_current"/>
        <state_interface name="status"/>
      </joint>

      <joint name="shoulder_pitch">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <command_interface name="maintenance_request"/>
        <command_interface name="maintenance_frame_high"/>
        <command_interface name="maintenance_frame_low"/>
        <command_interface name="maintenance_data_count"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="motor_temperature"/>
        <state_interface name="torque_current"/>
        <state_interface name="status"/>
      </joint>

      <joint name="elbow_pitch">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <command_interface name="maintenance_request"/>
        <command_interface name="maintenance_frame_high"/>
        <command_interface name="maintenance_frame_low"/>
        <command_interface name="maintenance_data_count"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="motor_temperature"/>
        <state_interface name="torque_current"/>
        <state_interface name="status"/>
      </joint>

      <joint name="wrist_pitch">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <command_interface name="maintenance_request"/>
        <command_interface name="maintenance_frame_high"/>
        <command_interface name="maintenance_frame_low"/>
        <command_interface name="maintenance_data_count"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="motor_temperature"/>
        <state_interface name="torque_current"/>
        <state_interface name="status"/>
      </joint>

      <joint name="wrist_roll">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <command_interface name="maintenance_request"/>
        <command_interface name="maintenance_frame_high"/>
        <command_interface name="maintenance_frame_low"/>
        <command_interface name="maintenance_data_count"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="motor_temperature"/>
        <state_interface name="torque_current"/>
        <state_interface name="status"/>
      </joint>

      <joint name="wrist_motor_a">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="motor_temperature"/>
        <state_interface name="torque_current"/>
        <state_interface name="status"/>
      </joint>

      <joint name="wrist_motor_b">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="motor_temperature"/>
        <state_interface name="torque_current"/>
        <state_interface name="status"/>
      </joint>

      <joint name="wrist_motor_c">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="motor_temperature"/>
        <state_interface name="torque_current"/>
        <state_interface name="status"/>
      </joint>

      <joint name="gripper_claw">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="motor_temperature"/>
        <state_interface name="torque_current"/>
        <state_interface name="status"/>
      </joint>

      <joint name="actuator">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <command_interface name="maintenance_request"/>
        <command_interface name="maintenance_frame_high"/>
        <command_interface name="maintenance_frame_low"/>
        <command_interface name="maintenance_data_count"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="status"/>
      </joint>

      <joint name="cam_0">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <command_interface name="maintenance_request"/>
        <command_interface name="maintenance_frame_high"/>
        <command_interface name="maintenance_frame_low"/>
        <command_interface name="maintenance_data_count"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="status"/>
      </joint>

      <joint name="cam_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="status_request"/>
        <command_interface name="maintenance_request"/>
        <command_interface name="maintenance_frame_high"/>
        <command_interface name="maintenance_frame_low"/>
        <command_interface name="maintenance_data_count"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="status"/>
      </joint>

      <joint name="base_yaw_encoder">
        <command_interface name="state_request"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="elbow_pitch_encoder">
        <command_interface name="state_request"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="shoulder_pitch_encoder">
        <command_interface name="state_request"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <gpio name="limit_switch_0">
        <command_interface name="status_request"/>
        <state_interface name="status"/>
      </gpio>

      <gpio name="limit_switch_1">
        <command_interface name="status_request"/>
        <state_interface name="status"/>
      </gpio>

      <gpio name="limit_switch_2">
        <command_interface name="status_request"/>
        <state_interface name="status"/>
      </gpio>

      <gpio name="limit_switch_3">
        <command_interface name="status_request"/>
        <state_interface name="status"/>
      </gpio>

      <gpio name="limit_switch_4">
        <command_interface name="status_request"/>
        <state_interface name="status"/>
      </gpio>
    </ros2_control>

  </xacro:macro>

</robot>
